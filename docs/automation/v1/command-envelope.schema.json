{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpoet.local/schemas/automation/v1/command-envelope.schema.json",
  "title": "OpenPoet Automation API v1 Command Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "capability", "target", "payload"],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Alternative to the Idempotency-Key header. If both are sent, they must match."
    },
    "actor": {
      "type": ["object", "null"],
      "description": "Accepted for connector compatibility but never trusted. The effective actor always comes from the bearer token."
    },
    "capability": {
      "type": "string",
      "enum": [
        "tasks.list",
        "tasks.get",
        "tasks.create",
        "tasks.update",
        "tasks.change_status",
        "tasks.delete",
        "tasks.duplicate",
        "tasks.reorder_project",
        "tasks.reorder_global",
        "tasks.approve_verification",
        "tasks.reject_verification",
        "tasks.link_session",
        "tasks.unlink_session",
        "tasks.add_comment",
        "work_runs.list",
        "work_runs.get",
        "work_runs.start",
        "work_runs.pause",
        "work_runs.resume",
        "work_runs.complete",
        "work_runs.cancel",
        "plans.upsert",
        "plans.list",
        "plans.items"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "payload": {
      "type": ["object", "array"]
    },
    "expected_version": {
      "type": ["integer", "null"],
      "description": "Optimistic concurrency version for work-run transitions and plan upserts. Other capabilities return expected_version_unsupported."
    },
    "reason": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "approval_token": {
      "type": "string",
	  "minLength": 1,
      "description": "Opaque explicit-approval marker required by capabilities whose approval policy is explicit."
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["project", "task", "project_task", "session", "work_run", "plan"]
        },
        "kind": {
          "type": "string",
          "enum": ["project", "task", "project_task", "session", "work_run", "plan"]
        },
        "id": {
          "type": ["integer", "string"]
        },
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "integer",
          "minimum": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
