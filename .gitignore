# Binary / Build
/build/
/openpoet

# Database
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Node
#
# package.json/package-lock.json ARE tracked: they pin the dev-only Playwright
# used by the browser tests under tests/ (`make test-web`). Nothing here ships
# in the Go binary.
node_modules/

# Screenshots / test files
#
# Screenshots are ignored by DEFAULT and the few real assets are opted back in
# below. Never comment this rule out to let a file
# through: add an exception below instead.
*.png
*.jpg
*.jpeg
!docs/images/*.png
!web/static/icon-*.png
!web/static/badge-*.png

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/
CLAUDE.md

# Codex files generated by configsync from the Claude ones
.agents/
.codex/config.toml
AGENTS.md

# Playwright MCP
.playwright-mcp/

# Scripts
.scripts/

# Run configs
.run/

# Live session credential written next to the dev DB (opav1_ bearer). It was
# only in .git/info/exclude, which is local — a fresh clone would not ignore it.
/coordinator.token

# Scratch dir of the isolation E2E harness (ops/lanes/e2e.sh): throwaway git
# repos, a sandbox DB and server logs. Never part of the tree.
.sandbox/

# OpenPoet config
.openpoet/

# OS
.DS_Store
Thumbs.db
