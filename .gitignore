# Screenshots / test files
#
# Screenshots are ignored by DEFAULT and the few real assets are opted back in
# below. Commenting this rule out (to let an icon through) is what leaked 65
# debug screenshots of client projects into a public repo — add an exception
# here instead, never disable the rule.
*.png
*.jpg
*.jpeg
!docs/images/*.png
!web/static/icon-*.png
!web/static/badge-*.png

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/
CLAUDE.md

# Playwright MCP
.playwright-mcp/

# Scripts
.scripts/

# Run configs
.run/

# Live session credential written next to the dev DB (opav1_ bearer). It was
# only in .git/info/exclude, which is local — a fresh clone would not ignore it.
/coordinator.token

# Scratch dir of the isolation E2E harness (ops/lanes/e2e.sh): throwaway git
# repos, a sandbox DB and server logs. Never part of the tree.
.sandbox/

# OpenPoet config
.openpoet/

