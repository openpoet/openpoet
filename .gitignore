# Binary / Build
/build/
/openpoet

# Database
*.db
*.db-shm
*.db-wal
# Encryption key file the server creates next to the database when
# OPENPOET_ENCRYPT_KEY is unset (internal/security/keyfile.go). It decrypts
# every stored credential — never commit it.
openpoet.key
openpoet.key.*
.openpoet.key.tmp-*
*.db-journal
*.sqlite
*.sqlite3

# Logs
*.log
nohup*.out

# Secrets: env files, keys and certificates (.env.example stays versionable)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Local MCP client config (may carry tokens)
.mcp.json

# Network captures
*.har

# Node
#
# package.json/package-lock.json ARE tracked: they pin the dev-only Playwright
# used by the browser tests under tests/ (`make test-web`). Nothing here ships
# in the Go binary.
node_modules/

# Screenshots / captures
#
# Images, animations and PDFs are ignored by DEFAULT (debug captures must never
# be committed) and the few real assets are opted back in below. To version a
# new asset, add an explicit exception here; never disable these rules.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
!docs/images/*.png
!web/static/icon-*.png
!web/static/badge-*.png

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/
CLAUDE.md

# Codex files generated by configsync from the Claude ones
.agents/
.codex/config.toml
AGENTS.md
.acp/instructions.md
.github/copilot-instructions.md
.github/hooks/

# Playwright MCP
.playwright-mcp/

# Scripts
.scripts/

# Run configs
.run/

# Live session credential written next to the dev DB (opav1_ bearer). It was
# only in .git/info/exclude, which is local — a fresh clone would not ignore it.
/coordinator.token

# Scratch dir of the isolation E2E harness (ops/lanes/e2e.sh): throwaway git
# repos, a sandbox DB and server logs. Never part of the tree.
.sandbox/

# OpenPoet config
.openpoet/

# OS
.DS_Store
Thumbs.db
