#!/bin/sh

# Pre-commit hook: check formatting and run go vet

echo "Checking gofmt..."
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo "The following files are not formatted:"
    echo "$UNFORMATTED"
    echo ""
    echo "Run 'make format' to fix. Commit aborted."
    exit 1
fi

echo "Running go vet..."
go vet ./...
if [ $? -ne 0 ]; then
    echo "go vet failed. Commit aborted."
    exit 1
fi

# Publication guard: OpenPoet is open source. Secrets (gitleaks), internal
# IPs/paths, the local denylist and forbidden files never get committed.
# See docs/publish-guard.md.
echo "Running publish guard..."
./ops/publish-guard/guard.sh staged
if [ $? -ne 0 ]; then
    echo "Publish guard failed. Commit aborted."
    exit 1
fi
