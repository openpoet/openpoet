# devbox apps: <app>.@@SUBZONE@@ -> devbox-proxy at @@PROXY_ADDR@@ (Host
# preserved; the proxy routes by Host and drops unknown names). Private network
# only. One DNS label below the subzone, which is what the wildcard
# certificate covers. Rendered by render-edge.sh from the OpenPoet repository
# (ops/devbox-proxy); do not edit the rendered copy.

server {
    listen 80;
    server_name "~^[a-z0-9]+(-[a-z0-9]+)*\.@@SUBZONE_RE@@$";

    location /.well-known/acme-challenge/ {
        root /var/www/certbot/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name "~^[a-z0-9]+(-[a-z0-9]+)*\.@@SUBZONE_RE@@$";

    ssl_certificate /etc/letsencrypt/live/@@CERT_NAME@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@CERT_NAME@@/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        allow @@ALLOW_CIDR@@;
        deny all;

        proxy_pass http://@@PROXY_ADDR@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
}
